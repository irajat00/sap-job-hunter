# Copy this file to .env and fill in your values.

DATABASE_URL=sqlite:///./jobs.db

# GET /jobs excludes postings older than this many days (posted_date
# null/missing/unparseable is never excluded). Defaults to 90 if unset.
JOB_MAX_AGE_DAYS=90

# Free credentials from https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Adzuna's real supported countries (19 total) -- there is no UAE/Gulf
# coverage, so "ae" is intentionally not included; see README.
ADZUNA_COUNTRIES=gb,us,de,fr,in,ca,au,nz,za,pl,nl,it,es,at,be,br,mx,sg,ch

# Jooble: free registration, no per-call cost. Get a key at
# https://jooble.org/api/about
JOOBLE_API_KEY=

# JSearch (RapidAPI) - only needed once collectors/jsearch.py is implemented
# JSEARCH_API_KEY=

# ATS company lists (Greenhouse/Lever/Ashby/SmartRecruiters). These
# collectors are built and tested but NOT currently active in
# collectors/runner.py -- see that file and README.md. Leave unset for
# now; only relevant once/if you decide to activate them.
# GREENHOUSE_COMPANIES=
# LEVER_COMPANIES=
# ASHBY_COMPANIES=
# SMARTRECRUITERS_COMPANIES=

# Telegram notifications - see notifiers/telegram.py for setup steps.
# Never hardcode these anywhere else; they are only ever read from here.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# SEARCH_KEYWORDS is authoritative -- this is what actually controls
# what gets searched. Comma-separated, no code changes needed to
# change it. This app collects SAP Manufacturing (PP/QM) jobs only --
# the list below covers every keyword required.
SEARCH_KEYWORDS=SAP PP,SAP QM,SAP PP/QM,SAP Production Planning,SAP Manufacturing,SAP APO PPDS,SAP S/4HANA PP,SAP S/4HANA Manufacturing,SAP Digital Manufacturing
# SEARCH_LOCATIONS=Dubai,Remote

# RSS feeds (comma-separated URLs), empty = collector no-ops
RSS_FEED_URLS=

# Email-alert feed (IMAP), empty = collector no-ops
EMAIL_IMAP_HOST=
EMAIL_IMAP_USER=
EMAIL_IMAP_PASSWORD=
EMAIL_IMAP_FOLDER=INBOX
